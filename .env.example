# mlbreview environment variables
# Copy to .env locally; in production these are set as GitHub Actions secrets.

# Resend transactional email API key (sending-only scope recommended)
RESEND_API_KEY=

# Anthropic API key for storyline prose generation
ANTHROPIC_API_KEY=

# Recipient email address for the daily digest
DIGEST_TO_EMAIL=

# From address (must be a verified Resend sender / domain)
DIGEST_FROM_EMAIL=
