<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MLB Digest — {{ digest.digest_date | format_date }}</title>
<style>
  :root {
    --navy: #1a3a5c;
    --blue: #2563eb;
    --amber: #f59e0b;
    --gray-50: #f8fafc;
    --gray-100: #f1f5f9;
    --gray-200: #e2e8f0;
    --gray-400: #94a3b8;
    --gray-600: #475569;
    --gray-800: #1e293b;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: var(--gray-100); color: var(--gray-800); line-height: 1.6; }
  .container { max-width: 720px; margin: 0 auto; padding: 24px 16px; }
  header { background: var(--navy); color: #fff; padding: 32px 24px; border-radius: 12px 12px 0 0; text-align: center; }
  header h1 { font-size: 24px; font-weight: 700; }
  header .date { color: #a0c4e8; font-size: 14px; margin-top: 4px; }
  .content { background: #fff; padding: 0; border-radius: 0 0 12px 12px; }
  .section { padding: 24px; border-bottom: 1px solid var(--gray-200); }
  .section:last-child { border-bottom: none; }
  .section-title { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: var(--gray-400); margin-bottom: 16px; }
  .score-row { display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px solid var(--gray-100); font-size: 14px; }
  .score-row:last-child { border-bottom: none; }
  .team { flex: 1; }
  .team.winner { font-weight: 700; }
  .score { text-align: center; min-width: 60px; font-variant-numeric: tabular-nums; }
  .extra { color: var(--gray-400); font-size: 12px; margin-left: 4px; }
  .storyline { margin-bottom: 16px; padding: 16px; background: var(--gray-50); border-radius: 8px; border-left: 3px solid var(--blue); }
  .storyline:last-child { margin-bottom: 0; }
  .storyline-meta { font-size: 12px; color: var(--gray-600); font-weight: 600; text-transform: uppercase; margin-bottom: 6px; }
  .storyline-prose { font-size: 15px; }
  .preview { padding: 16px; background: #fef9ee; border-radius: 8px; border-left: 3px solid var(--amber); }
  .preview-meta { font-size: 12px; color: #92400e; font-weight: 600; text-transform: uppercase; margin-bottom: 6px; }
  .preview-prose { font-size: 15px; }
  .txn-list { list-style: none; }
  .txn-list li { padding: 6px 0; border-bottom: 1px solid var(--gray-100); font-size: 14px; color: var(--gray-600); }
  .txn-list li:last-child { border-bottom: none; }
  .nav { text-align: center; padding: 16px; }
  .nav a { color: var(--blue); text-decoration: none; font-size: 13px; }
  .nav a:hover { text-decoration: underline; }
  footer { text-align: center; padding: 24px; color: var(--gray-400); font-size: 12px; }
  .leaderboard-notice { padding: 16px 24px; background: #fef3cd; border-radius: 8px; font-size: 14px; color: #856404; text-align: center; }
  .lb-tabs { display: flex; gap: 4px; margin-bottom: 16px; flex-wrap: wrap; }
  .lb-tab { padding: 6px 14px; border: 1px solid var(--gray-200); border-radius: 6px; background: #fff; font-size: 13px; font-weight: 600; cursor: pointer; color: var(--gray-600); }
  .lb-tab.active { background: var(--navy); color: #fff; border-color: var(--navy); }
  .lb-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .lb-table th { text-align: left; padding: 8px 6px; border-bottom: 2px solid var(--gray-200); color: var(--gray-400); font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; cursor: pointer; user-select: none; white-space: nowrap; }
  .lb-table th:hover { color: var(--gray-800); }
  .lb-table th .sort-arrow { font-size: 10px; margin-left: 2px; }
  .lb-table td { padding: 7px 6px; border-bottom: 1px solid var(--gray-100); }
  .lb-table tr.detail-row td { padding: 6px 6px 10px 24px; background: var(--gray-50); font-size: 12px; color: var(--gray-600); }
  .lb-table .rank { color: var(--gray-400); width: 28px; }
  .lb-table .player-name { font-weight: 600; }
  .lb-table .team { color: var(--gray-400); font-size: 12px; }
  .lb-table .stat { font-variant-numeric: tabular-nums; text-align: right; }
  .badge { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: 600; }
  .badge.confirmed { background: #d1fae5; color: #065f46; }
  .badge.lucky { background: #fef3cd; color: #856404; }
  .badge.unlucky { background: #fee2e2; color: #991b1b; }
  .lb-panel { display: none; }
  .lb-panel.active { display: block; }
  .expand-btn { cursor: pointer; color: var(--gray-400); font-size: 12px; }
  .off-day { padding: 32px 24px; text-align: center; }
  .off-day h2 { color: var(--navy); margin-bottom: 8px; }
  .off-day p { color: var(--gray-600); }
  .tonight-schedule { margin-top: 20px; text-align: left; }
  .tonight-schedule .game { padding: 6px 0; border-bottom: 1px solid var(--gray-100); font-size: 14px; }
</style>
</head>
<body>
<div class="container">

<header>
  <h1>⚾ MLB Digest</h1>
  <div class="date">{{ digest.digest_date | format_date }}</div>
</header>

<div class="content">

{% if digest.is_off_day %}
<div class="off-day">
  <h2>{{ digest.off_day_headline }}</h2>
  <p>{{ digest.off_day_body }}</p>

  {% if digest.tonight_games %}
  <div class="tonight-schedule">
    <h3 style="font-size:14px; color:var(--navy); margin-bottom:8px;">Tonight's Schedule</h3>
    {% for g in digest.tonight_games %}
    <div class="game">
      {{ g.away_team_abbr }} @ {{ g.home_team_abbr }}
      {% if g.away_probable_pitcher and g.away_probable_pitcher.full_name %}
      <span style="color:var(--gray-400);">— {{ g.away_probable_pitcher.full_name }}</span>
      {% endif %}
      {% if g.home_probable_pitcher and g.home_probable_pitcher.full_name %}
      <span style="color:var(--gray-400);">vs {{ g.home_probable_pitcher.full_name }}</span>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}
</div>

{% else %}

{# ── Scores ── #}
<div class="section">
  <div class="section-title">Scores</div>
  {% for game in digest.games %}
  <div class="score-row">
    <span class="team{% if game.away_score > game.home_score %} winner{% endif %}">{{ game.away_team_abbr }}</span>
    <span class="score">
      <span{% if game.away_score > game.home_score %} style="font-weight:700"{% endif %}>{{ game.away_score }}</span>
      –
      <span{% if game.home_score > game.away_score %} style="font-weight:700"{% endif %}>{{ game.home_score }}</span>
    </span>
    <span class="team{% if game.home_score > game.away_score %} winner{% endif %}" style="text-align:right;">
      {{ game.home_team_abbr }}
      {% if game.extra_innings %}<span class="extra">({{ game.line_score | length }})</span>{% endif %}
    </span>
  </div>
  {% endfor %}
</div>

{# ── Storylines ── #}
{% if digest.storylines %}
<div class="section">
  <div class="section-title">Storylines</div>
  {% for story in digest.storylines %}
  <div class="storyline">
    <div class="storyline-meta">
      {{ story.scored.game.away_team_abbr }} @ {{ story.scored.game.home_team_abbr }}
      · {{ story.scored.game.away_score }}–{{ story.scored.game.home_score }}
      {% set cat_label = story.scored.category | category_label %}
      {% if cat_label %} · {{ cat_label }}{% endif %}
    </div>
    <div class="storyline-prose">{{ story.prose }}</div>
  </div>
  {% endfor %}
</div>
{% endif %}

{# ── Tonight ── #}
{% if digest.tonight %}
<div class="section">
  <div class="section-title">Tonight</div>
  <div class="preview">
    <div class="preview-meta">
      {{ digest.tonight.scored.game.away_team_abbr }} @ {{ digest.tonight.scored.game.home_team_abbr }}
      {% if digest.tonight.scored.game.is_national %} · National TV{% endif %}
    </div>
    <div class="preview-prose">{{ digest.tonight.prose }}</div>
  </div>
</div>
{% endif %}

{# ── Off-field ── #}
{% if digest.transactions %}
<div class="section">
  <div class="section-title">Off-field</div>
  <ul class="txn-list">
    {% for txn in digest.transactions %}
    <li>{{ txn.description }}</li>
    {% endfor %}
  </ul>
</div>
{% endif %}

{% endif %}

{# ── V2: Player Leaderboards ── #}
{% if digest.leaderboards %}
<div class="section">
  <div class="section-title">Player Leaderboards</div>

  {% if digest.leaderboards.snapshots_7d < 7 %}
  <div class="leaderboard-notice">
    Building up data — {{ digest.leaderboards.snapshots_7d }} of 7 days collected. Leaderboards become more accurate with a full week of data.
  </div>
  {% endif %}

  <div class="lb-tabs">
    <button class="lb-tab active" data-panel="hot-hitters">Hot Hitters</button>
    <button class="lb-tab" data-panel="cold-hitters">Cold Hitters</button>
    <button class="lb-tab" data-panel="hot-pitchers">Hot Pitchers</button>
    <button class="lb-tab" data-panel="cold-pitchers">Cold Pitchers</button>
    {% if digest.leaderboards.breakout_hitters %}
    <button class="lb-tab" data-panel="breakout-hitters">Breakout Hitters</button>
    {% endif %}
    {% if digest.leaderboards.breakout_pitchers %}
    <button class="lb-tab" data-panel="breakout-pitchers">Breakout Pitchers</button>
    {% endif %}
  </div>

  {# -- Hot Hitters -- #}
  <div class="lb-panel active" id="hot-hitters">
  {% if digest.leaderboards.hot_hitters %}
  <table class="lb-table" data-sortable>
    <thead>
      <tr>
        <th>#</th>
        <th>Player</th>
        <th class="stat">AVG</th>
        <th class="stat">HR</th>
        <th class="stat">RBI</th>
        <th class="stat">OPS</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
    {% for h in digest.leaderboards.hot_hitters %}
      <tr class="expand-btn" data-detail="hot-h-{{ loop.index }}">
        <td class="rank">{{ loop.index }}</td>
        <td><span class="player-name">{{ h.full_name }}</span> <span class="team">{{ h.team_abbr }}</span></td>
        <td class="stat">{{ h.avg | format_avg }}</td>
        <td class="stat">{{ h.home_runs }}</td>
        <td class="stat">{{ h.rbi }}</td>
        <td class="stat">{{ "%.3f" | format(h.obp + h.slg) }}</td>
        <td>{% set badge = h.luck_status.value | luck_badge %}{% if badge %}<span class="badge {{ h.luck_status.value | luck_class }}">{{ badge }}</span>{% endif %}</td>
      </tr>
      <tr class="detail-row" id="hot-h-{{ loop.index }}" style="display:none;">
        <td colspan="7">
          {{ h.games }} G · {{ h.plate_appearances }} PA · {{ h.stolen_bases }} SB · OBP {{ h.obp | format_avg }} · SLG {{ h.slg | format_avg }}
          {% if h.xwoba is not none %} · xwOBA {{ "%.3f" | format(h.xwoba) }}{% endif %}
          {% if h.barrel_pct is not none %} · Barrel {{ "%.1f" | format(h.barrel_pct) }}%{% endif %}
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p style="color:var(--gray-400);font-size:14px;">No qualified hitters yet.</p>
  {% endif %}
  </div>

  {# -- Cold Hitters -- #}
  <div class="lb-panel" id="cold-hitters">
  {% if digest.leaderboards.cold_hitters %}
  <table class="lb-table" data-sortable>
    <thead>
      <tr>
        <th>#</th>
        <th>Player</th>
        <th class="stat">AVG</th>
        <th class="stat">HR</th>
        <th class="stat">RBI</th>
        <th class="stat">OPS</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
    {% for h in digest.leaderboards.cold_hitters %}
      <tr class="expand-btn" data-detail="cold-h-{{ loop.index }}">
        <td class="rank">{{ loop.index }}</td>
        <td><span class="player-name">{{ h.full_name }}</span> <span class="team">{{ h.team_abbr }}</span></td>
        <td class="stat">{{ h.avg | format_avg }}</td>
        <td class="stat">{{ h.home_runs }}</td>
        <td class="stat">{{ h.rbi }}</td>
        <td class="stat">{{ "%.3f" | format(h.obp + h.slg) }}</td>
        <td>{% set badge = h.luck_status.value | luck_badge %}{% if badge %}<span class="badge {{ h.luck_status.value | luck_class }}">{{ badge }}</span>{% endif %}</td>
      </tr>
      <tr class="detail-row" id="cold-h-{{ loop.index }}" style="display:none;">
        <td colspan="7">
          {{ h.games }} G · {{ h.plate_appearances }} PA · {{ h.stolen_bases }} SB · OBP {{ h.obp | format_avg }} · SLG {{ h.slg | format_avg }}
          {% if h.xwoba is not none %} · xwOBA {{ "%.3f" | format(h.xwoba) }}{% endif %}
          {% if h.barrel_pct is not none %} · Barrel {{ "%.1f" | format(h.barrel_pct) }}%{% endif %}
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p style="color:var(--gray-400);font-size:14px;">No qualified hitters yet.</p>
  {% endif %}
  </div>

  {# -- Hot Pitchers -- #}
  <div class="lb-panel" id="hot-pitchers">
  {% if digest.leaderboards.hot_pitchers %}
  <table class="lb-table" data-sortable>
    <thead>
      <tr>
        <th>#</th>
        <th>Player</th>
        <th class="stat">ERA</th>
        <th class="stat">IP</th>
        <th class="stat">K</th>
        <th class="stat">Role</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
    {% for p in digest.leaderboards.hot_pitchers %}
      <tr class="expand-btn" data-detail="hot-p-{{ loop.index }}">
        <td class="rank">{{ loop.index }}</td>
        <td><span class="player-name">{{ p.full_name }}</span> <span class="team">{{ p.team_abbr }}</span></td>
        <td class="stat">{{ p.era | format_era }}</td>
        <td class="stat">{{ p.innings_pitched | format_ip }}</td>
        <td class="stat">{{ p.strikeouts }}</td>
        <td class="stat" style="text-transform:capitalize;">{{ p.role }}</td>
        <td>{% set badge = p.luck_status.value | luck_badge %}{% if badge %}<span class="badge {{ p.luck_status.value | luck_class }}">{{ badge }}</span>{% endif %}</td>
      </tr>
      <tr class="detail-row" id="hot-p-{{ loop.index }}" style="display:none;">
        <td colspan="7">
          {% if p.role == "starter" %}
            {{ p.starts }} GS · WHIP {{ p.whip | format_era }} · K/9 {{ p.k_per_9 | format_era }}
          {% else %}
            {{ p.appearances }} APP · {{ p.saves }} SV · {{ p.blown_saves }} BS · SV% {{ "%.0f" | format((p.save_pct or 0) * 100) }}%
          {% endif %}
          {% if p.fip is not none %} · FIP {{ p.fip | format_era }}{% endif %}
          {% if p.xera is not none %} · xERA {{ p.xera | format_era }}{% endif %}
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p style="color:var(--gray-400);font-size:14px;">No qualified pitchers yet.</p>
  {% endif %}
  </div>

  {# -- Cold Pitchers -- #}
  <div class="lb-panel" id="cold-pitchers">
  {% if digest.leaderboards.cold_pitchers %}
  <table class="lb-table" data-sortable>
    <thead>
      <tr>
        <th>#</th>
        <th>Player</th>
        <th class="stat">ERA</th>
        <th class="stat">IP</th>
        <th class="stat">K</th>
        <th class="stat">Role</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
    {% for p in digest.leaderboards.cold_pitchers %}
      <tr class="expand-btn" data-detail="cold-p-{{ loop.index }}">
        <td class="rank">{{ loop.index }}</td>
        <td><span class="player-name">{{ p.full_name }}</span> <span class="team">{{ p.team_abbr }}</span></td>
        <td class="stat">{{ p.era | format_era }}</td>
        <td class="stat">{{ p.innings_pitched | format_ip }}</td>
        <td class="stat">{{ p.strikeouts }}</td>
        <td class="stat" style="text-transform:capitalize;">{{ p.role }}</td>
        <td>{% set badge = p.luck_status.value | luck_badge %}{% if badge %}<span class="badge {{ p.luck_status.value | luck_class }}">{{ badge }}</span>{% endif %}</td>
      </tr>
      <tr class="detail-row" id="cold-p-{{ loop.index }}" style="display:none;">
        <td colspan="7">
          {% if p.role == "starter" %}
            {{ p.starts }} GS · WHIP {{ p.whip | format_era }} · K/9 {{ p.k_per_9 | format_era }}
          {% else %}
            {{ p.appearances }} APP · {{ p.saves }} SV · {{ p.blown_saves }} BS · SV% {{ "%.0f" | format((p.save_pct or 0) * 100) }}%
          {% endif %}
          {% if p.fip is not none %} · FIP {{ p.fip | format_era }}{% endif %}
          {% if p.xera is not none %} · xERA {{ p.xera | format_era }}{% endif %}
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p style="color:var(--gray-400);font-size:14px;">No qualified pitchers yet.</p>
  {% endif %}
  </div>

  {# -- Breakout Hitters -- #}
  {% if digest.leaderboards.breakout_hitters %}
  <div class="lb-panel" id="breakout-hitters">
  <table class="lb-table" data-sortable>
    <thead>
      <tr>
        <th>#</th>
        <th>Player</th>
        <th class="stat">AVG</th>
        <th class="stat">HR</th>
        <th class="stat">RBI</th>
        <th class="stat">OPS</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
    {% for h in digest.leaderboards.breakout_hitters %}
      <tr class="expand-btn" data-detail="brk-h-{{ loop.index }}">
        <td class="rank">{{ loop.index }}</td>
        <td><span class="player-name">{{ h.full_name }}</span> <span class="team">{{ h.team_abbr }}</span></td>
        <td class="stat">{{ h.avg | format_avg }}</td>
        <td class="stat">{{ h.home_runs }}</td>
        <td class="stat">{{ h.rbi }}</td>
        <td class="stat">{{ "%.3f" | format(h.obp + h.slg) }}</td>
        <td>{% set badge = h.luck_status.value | luck_badge %}{% if badge %}<span class="badge {{ h.luck_status.value | luck_class }}">{{ badge }}</span>{% endif %}</td>
      </tr>
      <tr class="detail-row" id="brk-h-{{ loop.index }}" style="display:none;">
        <td colspan="7">
          {{ h.games }} G · {{ h.plate_appearances }} PA · 15-day window
          {% if h.xwoba is not none %} · xwOBA {{ "%.3f" | format(h.xwoba) }}{% endif %}
          {% if h.barrel_pct is not none %} · Barrel {{ "%.1f" | format(h.barrel_pct) }}%{% endif %}
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% endif %}

  {# -- Breakout Pitchers -- #}
  {% if digest.leaderboards.breakout_pitchers %}
  <div class="lb-panel" id="breakout-pitchers">
  <table class="lb-table" data-sortable>
    <thead>
      <tr>
        <th>#</th>
        <th>Player</th>
        <th class="stat">ERA</th>
        <th class="stat">IP</th>
        <th class="stat">K</th>
        <th class="stat">Role</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
    {% for p in digest.leaderboards.breakout_pitchers %}
      <tr class="expand-btn" data-detail="brk-p-{{ loop.index }}">
        <td class="rank">{{ loop.index }}</td>
        <td><span class="player-name">{{ p.full_name }}</span> <span class="team">{{ p.team_abbr }}</span></td>
        <td class="stat">{{ p.era | format_era }}</td>
        <td class="stat">{{ p.innings_pitched | format_ip }}</td>
        <td class="stat">{{ p.strikeouts }}</td>
        <td class="stat" style="text-transform:capitalize;">{{ p.role }}</td>
        <td>{% set badge = p.luck_status.value | luck_badge %}{% if badge %}<span class="badge {{ p.luck_status.value | luck_class }}">{{ badge }}</span>{% endif %}</td>
      </tr>
      <tr class="detail-row" id="brk-p-{{ loop.index }}" style="display:none;">
        <td colspan="7">
          15-day window
          {% if p.fip is not none %} · FIP {{ p.fip | format_era }}{% endif %}
          {% if p.xera is not none %} · xERA {{ p.xera | format_era }}{% endif %}
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% endif %}

</div>
{% endif %}

</div>

<div class="nav">
  <a href="../../">← All digests</a>
</div>

<footer>
  mlbreview · {{ digest.digest_date | format_date }}
</footer>

</div>

<script>
/* Tab switching */
document.querySelectorAll('.lb-tab').forEach(function(tab) {
  tab.addEventListener('click', function() {
    document.querySelectorAll('.lb-tab').forEach(function(t) { t.classList.remove('active'); });
    document.querySelectorAll('.lb-panel').forEach(function(p) { p.classList.remove('active'); });
    tab.classList.add('active');
    var panel = document.getElementById(tab.getAttribute('data-panel'));
    if (panel) panel.classList.add('active');
  });
});

/* Expand/collapse detail rows */
document.querySelectorAll('.expand-btn').forEach(function(row) {
  row.addEventListener('click', function() {
    var detailId = row.getAttribute('data-detail');
    var detail = document.getElementById(detailId);
    if (detail) {
      detail.style.display = detail.style.display === 'none' ? '' : 'none';
    }
  });
});

/* Column sorting */
document.querySelectorAll('.lb-table[data-sortable] th').forEach(function(th) {
  th.addEventListener('click', function() {
    var table = th.closest('table');
    var tbody = table.querySelector('tbody');
    var idx = Array.from(th.parentNode.children).indexOf(th);
    var rows = Array.from(tbody.querySelectorAll('tr:not(.detail-row)'));
    var asc = th.getAttribute('data-sort-dir') !== 'asc';
    th.parentNode.querySelectorAll('th').forEach(function(t) { t.removeAttribute('data-sort-dir'); });
    th.setAttribute('data-sort-dir', asc ? 'asc' : 'desc');
    rows.sort(function(a, b) {
      var av = a.children[idx] ? a.children[idx].textContent.trim() : '';
      var bv = b.children[idx] ? b.children[idx].textContent.trim() : '';
      var an = parseFloat(av), bn = parseFloat(bv);
      if (!isNaN(an) && !isNaN(bn)) {
        return asc ? an - bn : bn - an;
      }
      return asc ? av.localeCompare(bv) : bv.localeCompare(av);
    });
    rows.forEach(function(row) {
      var detailId = row.getAttribute('data-detail');
      var detail = detailId ? document.getElementById(detailId) : null;
      tbody.appendChild(row);
      if (detail) tbody.appendChild(detail);
    });
  });
});
</script>

</body>
</html>
