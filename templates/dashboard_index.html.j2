<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MLB Digest — Archive</title>
<style>
  :root {
    --navy: #1a3a5c;
    --blue: #2563eb;
    --gray-50: #f8fafc;
    --gray-100: #f1f5f9;
    --gray-200: #e2e8f0;
    --gray-400: #94a3b8;
    --gray-600: #475569;
    --gray-800: #1e293b;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: var(--gray-100); color: var(--gray-800); line-height: 1.6; }
  .container { max-width: 720px; margin: 0 auto; padding: 24px 16px; }
  header { background: var(--navy); color: #fff; padding: 32px 24px; border-radius: 12px 12px 0 0; text-align: center; }
  header h1 { font-size: 24px; font-weight: 700; }
  header p { color: #a0c4e8; font-size: 14px; margin-top: 4px; }
  .content { background: #fff; border-radius: 0 0 12px 12px; padding: 8px 0; }
  .entry { display: flex; justify-content: space-between; align-items: center; padding: 14px 24px; border-bottom: 1px solid var(--gray-100); text-decoration: none; color: inherit; }
  .entry:last-child { border-bottom: none; }
  .entry:hover { background: var(--gray-50); }
  .entry-date { font-size: 14px; font-weight: 600; color: var(--navy); min-width: 120px; }
  .entry-headline { font-size: 14px; color: var(--gray-600); flex: 1; margin-left: 16px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .collapsed { text-align: center; padding: 16px; color: var(--gray-400); font-size: 13px; }
  footer { text-align: center; padding: 24px; color: var(--gray-400); font-size: 12px; }
</style>
</head>
<body>
<div class="container">

<header>
  <h1>⚾ MLB Digest</h1>
  <p>Daily digest archive</p>
</header>

<div class="content">
  {% for entry in entries[:30] %}
  <a class="entry" href="{{ entry.url }}">
    <span class="entry-date">{{ entry.date | format_date }}</span>
    <span class="entry-headline">{{ entry.headline }}</span>
  </a>
  {% endfor %}

  {% if entries | length > 30 %}
  <div class="collapsed">
    + {{ entries | length - 30 }} older digests
  </div>
  {% endif %}

  {% if not entries %}
  <div class="collapsed">
    No digests yet. Check back after the first morning run.
  </div>
  {% endif %}
</div>

<footer>
  mlbreview
</footer>

</div>
</body>
</html>
